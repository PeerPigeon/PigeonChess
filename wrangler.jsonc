// PigeonChess on Cloudflare: the app (static, dist/), served at chess.peer.ooo,
// and one small Worker (worker/index.ts) for /api/*: it sends "Your move" and
// "Your game started" notifications. Its VAPID key pair is two secrets,
// VAPID_PRIVATE_JWK and VAPID_PUBLIC_KEY, made and stored once with
//   npm run push-keys
// (scripts/push-keys.mjs; the private key is never shown or written to disk).
// A link to a shared game (/?game=…) gets its own social card from the Worker too.
// Deploy with `npm run deploy` (builds, then uploads dist/ and the Worker).
{
  "name": "pigeonchess",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/pigeon", "/pigeon/"]
  },
  "routes": [
    { "pattern": "chess.peer.ooo/*", "zone_name": "peer.ooo" }
  ]
}
