# The page itself is always checked with the server, so a new build shows on
# the next load (its scripts have new names; the old ones may stay cached).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
# Cloudflare static assets: let browsers keep piece art and sounds instead of
# asking the server again on every load. Built files under /assets/ have
# content hashes in their names, so they never change.
/pieces/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/stockfish/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
