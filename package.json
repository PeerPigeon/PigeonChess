    "pigeonidp": "https://codeload.github.com/PeerPigeon/PigeonIdP/tar.gz/2d7d986c6ef2f449aecbd2dc2ab3f21bfb315158",
    "unsea": "https://codeload.github.com/draeder/unsea/tar.gz/467fa5be2270b285a4a7c147393260f207d11224",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
